+/* [prj4] Detect Cosmos+ OpenSSD by the model name (mn) in Identify Controller */
+static bool nvme_is_cosmos_openssd(const struct nvme_id_ctrl *id)
+{
+	return !strncasecmp(id->mn, "COSMOS+", 7);
+}
