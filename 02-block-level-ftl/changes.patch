+// [prj2] Block-level FTL Read
+//        The mapping table stores only LBN -> physical block (the VSA of its page 0).
+//        The page inside the block is not stored; it is computed from the LSA offset.
 unsigned int AddrTransRead(unsigned int logicalSliceAddr)
 {
 	unsigned int virtualSliceAddr;
 
 	if(logicalSliceAddr < SLICES_PER_SSD)
 	{
-		virtualSliceAddr = logicalSliceMapPtr->logicalSlice[logicalSliceAddr].virtualSliceAddr;
+		// [prj2] Split the LSA into LBN (block number) and offset in the block (1 block = 256 slices)
+		unsigned int lbn = logicalSliceAddr / SLICES_PER_BLOCK;
+		unsigned int offset = logicalSliceAddr % SLICES_PER_BLOCK;
+
+		// [prj2] Look up the table by LBN, not LSA -> 1/256 as many entries as page-level
+		virtualSliceAddr = logicalSliceMapPtr->logicalSlice[lbn].virtualSliceAddr;
 
 		if(virtualSliceAddr != VSA_NONE)
-			return virtualSliceAddr;
+		{
+			// [prj2] Take die/block from the stored VSA and put the offset in the page field.
+			//        Sequential writes are stored in offset order, so this matches.
+			//        Random writes are stored in a different order, so it mismatches (a block-level limit).
+			unsigned int dieNo = Vsa2VdieTranslation(virtualSliceAddr);
+			unsigned int blockNo = Vsa2VblockTranslation(virtualSliceAddr);
+
+			unsigned int targetVsa = Vorg2VsaTranslation(dieNo, blockNo, offset);
+			return targetVsa;
+		}
 		else
 			return VSA_FAIL;
 	}
